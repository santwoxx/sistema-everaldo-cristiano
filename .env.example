# ---------------------------------------------------------------------------
# Banco de dados
# SQLite (padrao, zero configuracao):
DATABASE_URL="file:./dev.db"
# PostgreSQL (producao em Vercel/Neon/Supabase) - troque tambem o provider
# em prisma/schema.prisma para "postgresql":
# DATABASE_URL="postgresql://user:senha@host:5432/banco?schema=public"

# ---------------------------------------------------------------------------
# Seguranca - GERE UMA CHAVE NOVA PARA PRODUCAO:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="troque-esta-chave-por-uma-aleatoria-de-64-caracteres-no-minimo"

# URL publica do sistema (usada para montar os links enviados ao cliente)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Credenciais do primeiro administrador criado pelo seed
